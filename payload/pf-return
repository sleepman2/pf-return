#!/bin/bash
# pf-return —— 端口白名单管理（交互式）
# 用途：添加/删除需要「回包绕开旁路由，直接交给主路由」的端口
# 支持 TCP / UDP，支持从本机监听端口中直接选择，支持中英文界面
set -u

VERSION="1.1.1"

# ---------------------------------------------------------------- 语言
LANG_CLI=""
HELP=0

while [ $# -gt 0 ]; do
    case "$1" in
        --lang)   LANG_CLI="${2:-}"; shift 2 ;;
        --lang=*) LANG_CLI="${1#*=}"; shift ;;
        -h|--help) HELP=1; shift ;;
        -l|--list) ACTION=list; shift ;;
        -s|--sync) ACTION=sync; shift ;;
        -V|--version) echo "pf-return $VERSION"; exit 0 ;;
        *) shift ;;
    esac
done

ENV_FILE=${PF_RETURN_ENV:-/etc/pf-return/env}
SYNC=${PF_RETURN_SYNC:-/usr/local/sbin/pf-return-sync.sh}

# ---------------------------------------------------------------- i18n
LANG_SEL="${LANG_CLI:-${PF_RETURN_LANG:-}}"

t() {
    local k=$1; shift
    case "${LANG_SEL}:${k}" in
        zh:menu_title)      printf '%s' '端口白名单管理' ;;
        en:menu_title)      printf '%s' 'Port Whitelist Manager' ;;
        zh:menu_cur)        printf '%s' '当前白名单（端口/协议）:' ;;
        en:menu_cur)        printf '%s' 'Current whitelist (port/proto):' ;;
        zh:empty_list)      printf '%s' '（白名单为空）' ;;
        en:empty_list)      printf '%s' '(whitelist is empty)' ;;
        zh:menu_add)        printf '%s' '1) 添加端口（可从监听列表选择）' ;;
        en:menu_add)        printf '%s' '1) Add port (pick from listening ports)' ;;
        zh:menu_del)        printf '%s' '2) 删除端口' ;;
        en:menu_del)        printf '%s' '2) Remove port' ;;
        zh:menu_show)       printf '%s' '3) 查看白名单' ;;
        en:menu_show)       printf '%s' '3) Show whitelist' ;;
        zh:menu_lang)       printf '%s' '4) 切换语言 / Switch language' ;;
        en:menu_lang)       printf '%s' '4) Switch language / 切换语言' ;;
        zh:menu_quit)       printf '%s' '0) 退出' ;;
        en:menu_quit)       printf '%s' '0) Exit' ;;
        zh:ask_choice)      printf '%s' '请选择操作 [0-4]: ' ;;
        en:ask_choice)      printf '%s' 'Select [0-4]: ' ;;
        zh:invalid_choice)  printf '%s' '无效选择: %s' "$1" ;;
        en:invalid_choice)  printf '%s' "Invalid choice: $1" ;;
        zh:bye)             printf '%s' '已退出' ;;
        en:bye)             printf '%s' 'Bye' ;;
        zh:lang_switched)   printf '%s' '界面语言已切换为中文（已写入配置文件）' ;;
        en:lang_switched)   printf '%s' 'UI language switched to English (saved to config file)' ;;
        zh:lang_session)    printf '%s' '界面语言已切换为中文（仅本次会话）' ;;
        en:lang_session)    printf '%s' 'UI language switched to English (this session only)' ;;

        zh:listen_title)    printf '%s' '本机正在监听的端口：' ;;
        en:listen_title)    printf '%s' 'Listening ports on this host:' ;;
        zh:listen_header)   printf '  #    端口  协议  绑定地址%17s进程%13s备注\n' '' '' ;;
        en:listen_header)   printf '  #    PORT  PROTO ADDRESS%18sPROCESS%10sNOTE\n' '' '' ;;
        zh:no_listen)       printf '%s' '（未检测到监听端口，请手动输入）' ;;
        en:no_listen)       printf '%s' '(no listening ports detected, please enter manually)' ;;
        zh:too_many)        printf '%s' '  ...（超过 60 条，其余请手动输入）' ;;
        en:too_many)        printf '%s' '  ... (more than 60 entries, please enter the rest manually)' ;;
        zh:flag_added)      printf '%s' '[已在白名单]' ;;
        en:flag_added)      printf '%s' '[already added]' ;;
        zh:flag_loop)       printf '%s' '[仅本机]' ;;
        en:flag_loop)       printf '%s' '[loopback only]' ;;
        zh:ask_add)         printf '%s' '请输入编号（如 1,3）或端口（手动输入加 p: 前缀，如 p:8080；0 返回）: ' ;;
        en:ask_add)         printf '%s' 'Select number(s) (e.g. 1,3) or port (manual input with p:, e.g. p:8080; 0 back): ' ;;
        zh:ask_proto)       printf '%s' "手动端口 $1 使用的协议 [tcp/udp/both]（默认 tcp）: " ;;
        en:ask_proto)       printf '%s' "Protocol for manual port(s) $1 [tcp/udp/both] (default tcp): " ;;

        zh:wl_title)        printf '%s' '当前白名单：' ;;
        en:wl_title)        printf '%s' 'Current whitelist:' ;;
        zh:wl_header)       printf "  #    端口/协议    状态       进程\\n" ;;
        en:wl_header)       printf "  #    PORT/PROTO   STATUS     PROCESS\\n" ;;
        zh:listening)       printf '%s' '监听中' ;;
        en:listening)       printf '%s' 'listening' ;;
        zh:not_listening)   printf '%s' '未监听' ;;
        en:not_listening)   printf '%s' 'not listening' ;;
        zh:ask_del)         printf '%s' '请输入编号（如 1,2）或端口（手动输入加 p: 前缀；0 返回）: ' ;;
        en:ask_del)         printf '%s' 'Select number(s) (e.g. 1,2) or port (manual input with p:; 0 back): ' ;;

        zh:ok)              printf '%s' '结果: 成功' ;;
        en:ok)              printf '%s' 'Result: SUCCESS' ;;
        zh:ok_note)         printf '%s' "说明: $1" ;;
        en:ok_note)         printf '%s' "Note: $1" ;;
        zh:fail)            printf '%s' '结果: 失败' ;;
        en:fail)            printf '%s' 'Result: FAILURE' ;;
        zh:reason)          printf '%s' "原因: $1" ;;
        en:reason)          printf '%s' "Reason: $1" ;;

        zh:err_root)        printf '%s' '需要 root 权限，请用 sudo 运行' ;;
        en:err_root)        printf '%s' 'root privileges required, run with sudo' ;;
        zh:err_env)         printf '%s' "找不到配置文件 $1" ;;
        en:err_env)         printf '%s' "config file not found: $1" ;;
        zh:err_sync)        printf '%s' "找不到同步脚本 $1" ;;
        en:err_sync)        printf '%s' "sync script not found: $1" ;;
        zh:err_ipt)         printf '%s' '系统缺少 iptables 命令' ;;
        en:err_ipt)         printf '%s' 'iptables not found' ;;
        zh:err_write)       printf '%s' "无法写入白名单文件 $1" ;;
        en:err_write)       printf '%s' "cannot write whitelist file $1" ;;
        zh:err_empty)       printf '%s' '输入为空' ;;
        en:err_empty)       printf '%s' 'empty input' ;;
        zh:err_unknown)     printf '%s' "无法识别的输入：$1（编号、p:端口 或 端口/协议）" ;;
        en:err_unknown)     printf '%s' "unrecognized input: $1 (number, p:port, or port/proto)" ;;
        zh:err_nan)         printf '%s' "端口 \"$1\" 不是合法数字" ;;
        en:err_nan)         printf '%s' "port \"$1\" is not a number" ;;
        zh:err_range)       printf '%s' "端口 $1 超出范围（1-65535）" ;;
        en:err_range)       printf '%s' "port $1 out of range (1-65535)" ;;
        zh:err_proto)       printf '%s' "协议 \"$1\" 无效，只能是 tcp / udp / both" ;;
        en:err_proto)       printf '%s' "invalid protocol \"$1\", expected tcp / udp / both" ;;
        zh:err_proto2)      printf '%s' "协议 \"$1\" 无效，只能是 tcp / udp" ;;
        en:err_proto2)      printf '%s' "invalid protocol \"$1\", expected tcp / udp" ;;
        zh:err_exists)      printf '%s' "端口 $1 已在白名单中（当前: $2）" ;;
        en:err_exists)      printf '%s' "port $1 is already whitelisted (current: $2)" ;;
        zh:err_missing)     printf '%s' "端口 $1 不在白名单中（当前: $2）" ;;
        en:err_missing)     printf '%s' "port $1 is not whitelisted (current: $2)" ;;
        zh:err_nothing)     printf '%s' '没有选中任何端口' ;;
        en:err_nothing)     printf '%s' 'no port selected' ;;
        zh:err_sync_run)    printf '%s' "规则下发失败：$1" ;;
        en:err_sync_run)    printf '%s' "failed to apply rules: $1" ;;
        zh:err_verify_add)  printf '%s' "iptables 规则校验未通过（$1 未生效，请检查 $2 与同步脚本）" ;;
        en:err_verify_add)  printf '%s' "rule verification failed ($1 not applied; check $2 and the sync script)" ;;
        zh:err_verify_del)  printf '%s' "端口 $1 的规则未能移除（iptables 可能被其他程序重写）" ;;
        en:err_verify_del)  printf '%s' "failed to remove rule for port $1 (iptables may be rewritten by another program)" ;;
        zh:added)           printf '%s' "已添加$1，当前白名单: $2" ;;
        en:added)           printf '%s' "added$1, whitelist: $2" ;;
        zh:removed)         printf '%s' "已删除 $1，当前白名单: $2" ;;
        en:removed)         printf '%s' "removed $1, whitelist: $2" ;;

        zh:help_l1)         printf '%s' '用法: pf-return [选项]' ;;
        en:help_l1)         printf '%s' 'Usage: pf-return [options]' ;;
        zh:help_l2)         printf '%s' '  --lang zh|en   界面语言（默认跟随系统 locale / 配置文件）' ;;
        en:help_l2)         printf '%s' '  --lang zh|en   UI language (default: system locale / config file)' ;;
        zh:help_l3)         printf '%s' '  -l, --list     列出白名单' ;;
        en:help_l3)         printf '%s' '  -l, --list     show whitelist' ;;
        zh:help_l4)         printf '%s' '  -s, --sync     重新下发规则' ;;
        en:help_l4)         printf '%s' '  -s, --sync     re-apply rules' ;;
        zh:help_l5)         printf '%s' '  -V, --version  版本号' ;;
        en:help_l5)         printf '%s' '  -V, --version  show version' ;;
        *) printf '%s' "$k" ;;
    esac
}

# ---------------------------------------------------------------- 配置
if [ ! -r "$ENV_FILE" ]; then
    LANG_SEL=${LANG_SEL:-zh}
    echo "$(t fail)"; echo "$(t reason "$(t err_env "$ENV_FILE")")"
    exit 1
fi
# shellcheck disable=SC1090
. "$ENV_FILE"

# 语言优先级: --lang > PF_RETURN_LANG > env 文件 UI_LANG > 系统 locale
if [ -z "$LANG_SEL" ]; then
    LANG_SEL="${UI_LANG:-}"
fi
if [ -z "$LANG_SEL" ]; then
    case "${LC_ALL:-${LANG:-}}" in
        zh*)              LANG_SEL=zh ;;
        ""|C|POSIX|C.*)   LANG_SEL=zh ;;
        *)                LANG_SEL=en ;;
    esac
fi
case "$LANG_SEL" in
    zh|en) ;;
    *) echo "invalid --lang: $LANG_SEL (zh|en)"; exit 1 ;;
esac
export PF_RETURN_LANG="$LANG_SEL"

PORTS_FILE=${PORTS_FILE:-/etc/pf-return/ports.conf}
LAN_CIDR=${LAN_CIDR:-192.168.1.0/24}
MARK=${MARK:-0x1}
COMMENT=${COMMENT:-pf-return}

LISTEN_ENTRY=()
LISTEN_PROC=()
LISTEN_COUNT=0
DEL_ENTRY=()
DEL_COUNT=0

# ---------------------------------------------------------------- 输出
ok()  { echo; echo "$(t ok)"; [ -n "${1:-}" ] && echo "$(t ok_note "$1")"; }
bad() { echo; echo "$(t fail)"; echo "$(t reason "$1")"; exit 1; }

# ---------------------------------------------------------------- 基础检查
[ "$(id -u)" -eq 0 ]                 || bad "$(t err_root)"
[ -x "$SYNC" ]                       || bad "$(t err_sync "$SYNC")"
command -v iptables >/dev/null 2>&1  || bad "$(t err_ipt)"
touch "$PORTS_FILE" 2>/dev/null      || bad "$(t err_write "$PORTS_FILE")"

if [ "$HELP" -eq 1 ]; then
    t help_l1; echo
    t help_l2; echo
    t help_l3; echo
    t help_l4; echo
    t help_l5; echo
    exit 0
fi

# ---------------------------------------------------------------- 白名单读写
list_entries() {
    grep -vE '^[[:space:]]*(#|$)' "$PORTS_FILE" 2>/dev/null | tr -d ' \t\r' | while IFS= read -r e; do
        case "$e" in
            */*) p=${e%/*}; pr=${e#*/} ;;
            *)   p=$e;       pr=tcp     ;;
        esac
        case "$p" in ''|*[!0-9]*) continue ;; esac
        [ "$p" -ge 1 ] && [ "$p" -le 65535 ] || continue
        case "$pr" in
            both) printf '%s/tcp\n%s/udp\n' "$p" "$p" ;;
            tcp|udp) printf '%s/%s\n' "$p" "$pr" ;;
        esac
    done | sort -t/ -k1,1n -k2,2 -u
}

rewrite_entries() {
    {
        echo "# pf-return 端口白名单：<端口>/<tcp|udp>，一行一条，# 开头为注释"
        cat
    } >"$PORTS_FILE.tmp" && mv "$PORTS_FILE.tmp" "$PORTS_FILE" || bad "$(t err_write "$PORTS_FILE")"
}

entry_exists() { list_entries | grep -qx -- "$1"; }

rule_exists() {
    local p=$1 proto=$2
    iptables -t mangle -C OUTPUT -p "$proto" -m "$proto" --sport "$p" \
        ! -d "$LAN_CIDR" -m comment --comment "$COMMENT" \
        -j MARK --set-xmark "${MARK}/0xffffffff" >/dev/null 2>&1
}

show_ports() {
    local list
    list=$(list_entries | tr '\n' ' ' | sed 's/ $//')
    if [ -z "$list" ]; then echo "  $(t empty_list)"; else echo "  $list"; fi
}

# ---------------------------------------------------------------- 监听端口
collect_listeners() {
    local raw
    raw=$(mktemp) || return 1

    if command -v ss >/dev/null 2>&1; then
        ss -tlnpH 2>/dev/null | awk '{print $4, "tcp", $6}' >>"$raw"
        ss -ulnpH 2>/dev/null | awk '{print $4, "udp", $6}' >>"$raw"
    elif command -v netstat >/dev/null 2>&1; then
        netstat -tlnp 2>/dev/null | awk 'NR>2 {print $4, "tcp", $7}' >>"$raw"
        netstat -unlp 2>/dev/null | awk 'NR>2 {print $4, "udp", $7}' >>"$raw"
    else
        rm -f "$raw"
        return 1
    fi

    awk '
    {
        local = $1; proto = $2; proc = $3
        n = split(local, a, ":")
        port = a[n]
        if (port !~ /^[0-9]+$/ || port < 1 || port > 65535) next

        addr = local
        sub(/:[^:]*$/, "", addr)
        if (addr == "") addr = "*"

        name = proc
        sub(/.*users:\(\("/, "", name)
        sub(/".*/, "", name)
        if (name ~ /^[0-9]+\//) sub(/^[0-9]+\//, "", name)

        key = port "/" proto
        if (!(key in seen)) {
            seen[key] = 1
            order[++cnt] = key
            addrs[key] = addr
            names[key] = name
        } else {
            if (index(addrs[key], addr) == 0) addrs[key] = addrs[key] "," addr
            if (names[key] == "") names[key] = name
        }
    }
    END {
        for (i = 1; i <= cnt; i++) {
            k = order[i]
            split(k, p, "/")
            printf "%s %s %s %s\n", p[1], p[2], addrs[k], (names[k] == "" ? "?" : names[k])
        }
    }' "$raw" | sort -k1,1n -k2,2

    rm -f "$raw"
}

is_loopback_only() {
    local IFS=, a all=1
    for a in $1; do
        case "$a" in
            127.*|::1|\[::1\]) ;;
            *) all=0 ;;
        esac
    done
    [ "$all" -eq 1 ]
}

show_add_menu() {
    local i=0 port proto addrs proc flags
    LISTEN_ENTRY=(); LISTEN_PROC=(); LISTEN_COUNT=0

    local data
    data=$(collect_listeners 2>/dev/null)

    echo
    if [ -z "$data" ]; then
        echo "  $(t no_listen)"
        return 0
    fi

    echo "  $(t listen_title)"
    t listen_header
    while read -r port proto addrs proc; do
        i=$((i + 1))
        [ "$i" -gt 60 ] && { t too_many; break; }
        flags=""
        entry_exists "$port/$proto" && flags="$flags $(t flag_added)"
        is_loopback_only "$addrs" && flags="$flags $(t flag_loop)"
        [ ${#addrs} -gt 23 ] && addrs="${addrs:0:20}..."
        [ ${#proc} -gt 16 ] && proc="${proc:0:15}."
        printf "  %-4s %-5s %-5s %-24s %-16s %s\n" "$i" "$port" "$proto" "$addrs" "$proc" "$flags"
        LISTEN_ENTRY[$i]="$port/$proto"
        LISTEN_PROC[$i]="$proc"
    done <<<"$data"
    LISTEN_COUNT=$i
}

show_del_menu() {
    local i=0 e p pr status proc
    local -A listening=()
    DEL_ENTRY=(); DEL_COUNT=0

    while read -r p pr _a proc; do
        listening["$p/$pr"]="$proc"
    done < <(collect_listeners 2>/dev/null)

    echo
    if [ "$(list_entries | wc -l)" -eq 0 ]; then
        echo "  $(t empty_list)"
        DEL_COUNT=0
        return 0
    fi

    echo "  $(t wl_title)"
    t wl_header
    while IFS= read -r e; do
        i=$((i + 1))
        p=${e%/*}; pr=${e#*/}
        proc=${listening[$e]:-}
        if [ -n "$proc" ]; then
            status="$(t listening)"
        else
            status="$(t not_listening)"
            proc="-"
        fi
        [ ${#proc} -gt 20 ] && proc="${proc:0:19}."
        printf "  %-4s %-12s %-10s %s\n" "$i" "$e" "$status" "$proc"
        DEL_ENTRY[$i]="$e"
    done < <(list_entries)
    DEL_COUNT=$i
}

# ---------------------------------------------------------------- 校验
check_port() {
    local p=$1
    [[ "$p" =~ ^[0-9]+$ ]] || { echo "$(t err_nan "$p")"; return 1; }
    [ "$p" -ge 1 ] && [ "$p" -le 65535 ] || { echo "$(t err_range "$p")"; return 1; }
    return 0
}

expand_proto() {
    case "$1" in
        both) printf 'tcp\nudp\n' ;;
        tcp|udp) printf '%s\n' "$1" ;;
        *) return 1 ;;
    esac
}

parse_ports() { echo "$1" | tr ',，;；' '    ' | tr -s ' '; }

run_sync() {
    local out
    if ! out=$("$SYNC" 2>&1); then
        bad "$(t err_sync_run "$(echo "$out" | tr '\n' ' ')")"
    fi
}

# ---------------------------------------------------------------- 菜单
persist_lang() {
    [ -w "$ENV_FILE" ] || return 1
    if grep -q '^UI_LANG=' "$ENV_FILE"; then
        sed -i "s/^UI_LANG=.*/UI_LANG=$LANG_SEL/" "$ENV_FILE" 2>/dev/null || return 1
    else
        printf '\nUI_LANG=%s\n' "$LANG_SEL" >>"$ENV_FILE" 2>/dev/null || return 1
    fi
    return 0
}

menu() {
    echo
    echo "================ $(t menu_title) ================"
    echo "$(t menu_cur)"
    show_ports
    echo "-----------------------------------------------"
    echo "  $(t menu_add)"
    echo "  $(t menu_del)"
    echo "  $(t menu_show)"
    echo "  $(t menu_lang)"
    echo "  $(t menu_quit)"
    echo "==============================================="
}

do_add() {
    local input proto token p pr entry msg
    local -a targets=()
    local -a manual=()
    local added="" failed=0

    show_add_menu

    read -r -p "$(t ask_add)" input
    [ -z "${input// /}" ] && bad "$(t err_empty)"
    [ "$input" = "0" ] && return 0

    for token in $(parse_ports "$input"); do
        case "$token" in
            0) return 0 ;;
            p:*|P:*)
                p=${token#*:}
                msg=$(check_port "$p") || bad "$msg"
                manual+=("$p")
                ;;
            */*)
                p=${token%/*}; pr=${token#*/}
                msg=$(check_port "$p") || bad "$msg"
                expand_proto "$pr" >/dev/null || bad "$(t err_proto "$pr")"
                for prr in $(expand_proto "$pr"); do targets+=("$p/$prr"); done
                ;;
            *)
                if ! [[ "$token" =~ ^[0-9]+$ ]]; then
                    bad "$(t err_unknown "$token")"
                fi
                if [ "$token" -ge 1 ] && [ "$token" -le "$LISTEN_COUNT" ]; then
                    targets+=("${LISTEN_ENTRY[$token]}")
                else
                    msg=$(check_port "$token") || bad "$msg"
                    manual+=("$token")
                fi
                ;;
        esac
    done

    if [ ${#manual[@]} -gt 0 ]; then
        read -r -p "$(t ask_proto "$(printf '%s ' "${manual[@]}")")" proto
        proto=${proto:-tcp}
        expand_proto "$proto" >/dev/null || bad "$(t err_proto "$proto")"
        for p in "${manual[@]}"; do
            for prr in $(expand_proto "$proto"); do targets+=("$p/$prr"); done
        done
    fi

    [ ${#targets[@]} -eq 0 ] && bad "$(t err_nothing)"

    for entry in "${targets[@]}"; do
        if entry_exists "$entry"; then
            bad "$(t err_exists "$entry" "$(list_entries | tr '\n' ' ' | sed 's/ $//')")"
        fi
    done

    { list_entries; printf '%s\n' "${targets[@]}"; } | rewrite_entries
    run_sync

    for entry in "${targets[@]}"; do
        if ! rule_exists "${entry%/*}" "${entry#*/}"; then
            failed=1
            break
        fi
        added="$added $entry"
    done
    [ $failed -eq 1 ] && bad "$(t err_verify_add "$entry" "$PORTS_FILE")"

    ok "$(t added "$added" "$(list_entries | tr '\n' ' ' | sed 's/ $//')")"
}

do_del() {
    local input token p pr entry matches msg
    local -a targets=()
    local removed="" failed=0

    show_del_menu

    read -r -p "$(t ask_del)" input
    [ -z "${input// /}" ] && bad "$(t err_empty)"
    [ "$input" = "0" ] && return 0

    for token in $(parse_ports "$input"); do
        case "$token" in
            0) return 0 ;;
            p:*|P:*)
                p=${token#*:}
                msg=$(check_port "$p") || bad "$msg"
                matches=$(list_entries | grep -E "^${p}/(tcp|udp)$")
                [ -z "$matches" ] && bad "$(t err_missing "$p" "$(list_entries | tr '\n' ' ' | sed 's/ $//')")"
                while IFS= read -r m; do targets+=("$m"); done <<<"$matches"
                ;;
            */*)
                p=${token%/*}; pr=${token#*/}
                msg=$(check_port "$p") || bad "$msg"
                case "$pr" in tcp|udp) ;; *) bad "$(t err_proto2 "$pr")" ;; esac
                entry_exists "$p/$pr" || bad "$(t err_missing "$p/$pr" "$(list_entries | tr '\n' ' ' | sed 's/ $//')")"
                targets+=("$p/$pr")
                ;;
            *)
                if ! [[ "$token" =~ ^[0-9]+$ ]]; then
                    bad "$(t err_unknown "$token")"
                fi
                if [ "$token" -ge 1 ] && [ "$token" -le "$DEL_COUNT" ]; then
                    targets+=("${DEL_ENTRY[$token]}")
                else
                    matches=$(list_entries | grep -E "^${token}/(tcp|udp)$")
                    [ -z "$matches" ] && bad "$(t err_missing "$token" "$(list_entries | tr '\n' ' ' | sed 's/ $//')")"
                    while IFS= read -r m; do targets+=("$m"); done <<<"$matches"
                fi
                ;;
        esac
    done

    [ ${#targets[@]} -eq 0 ] && bad "$(t err_nothing)"

    removed=$(printf '%s\n' "${targets[@]}" | sort -u | tr '\n' ' ' | sed 's/ $//')
    list_entries | grep -vxF -f <(printf '%s\n' "${targets[@]}" | sort -u) | rewrite_entries
    run_sync

    for entry in $(printf '%s\n' "${targets[@]}" | sort -u); do
        if rule_exists "${entry%/*}" "${entry#*/}"; then
            failed=1
            break
        fi
    done
    [ $failed -eq 1 ] && bad "$(t err_verify_del "$entry")"

    ok "$(t removed "$removed" "$(list_entries | tr '\n' ' ' | sed 's/ $//')")"
}

# ---------------------------------------------------------------- 入口
case "${ACTION:-}" in
    list) show_ports; exit 0 ;;
    sync) "$SYNC"; exit $? ;;
esac

main() {
    local choice
    while true; do
        menu
        read -r -p "$(t ask_choice)" choice
        case "$choice" in
            1) do_add ;;
            2) do_del ;;
            3) echo; show_ports ;;
            4)
                if [ "$LANG_SEL" = zh ]; then LANG_SEL=en; else LANG_SEL=zh; fi
                export PF_RETURN_LANG="$LANG_SEL"
                if persist_lang; then echo "$(t lang_switched)"; else echo "$(t lang_session)"; fi
                ;;
            0|q|Q|"") echo "$(t bye)"; exit 0 ;;
            *) echo; echo "$(t invalid_choice "$choice")" ;;
        esac
    done
}

main
