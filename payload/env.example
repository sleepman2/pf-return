# pf-return 配置模板（安装时由 install.sh 自动生成，通常无需手工复制）
GATEWAY=192.168.1.1          # 主路由（回包必须交给它）
IFACE=eth0                   # 本机出口网卡
TABLE=100                    # 策略路由表号
MARK=0x1                     # fwmark 标记
LAN_CIDR=192.168.1.0/24      # 局域网网段（发往这里的回包不标记）
PORTS_FILE=/etc/pf-return/ports.conf
COMMENT=pf-return            # iptables 规则注释，用于识别本脚本下发的规则
UI_LANG=                     # 界面语言：zh / en，留空则跟随系统 locale
